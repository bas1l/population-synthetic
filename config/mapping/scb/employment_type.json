{
  "reference_handler": "composite",
  "pipeline_handler": "text_coded",
  "pipeline_fuzzy": false,
  "pipeline_keyword_rules": [
    {"match": "contains", "any_of": ["not applicable", "n/a", "ej tillämpligt", "ej relevant", "ingen anställning", "volontär", "arbetsträning"], "label": "Not Applicable"},
    {"match": "contains", "any_of": ["self-employed", "freelance", "egenföretagare", "enskild firma", "konsultanställning", "egenanställd", "aktiebolag"], "label": "Self-Employed"},
    {"match": "contains", "any_of": ["projektanställning", "visstidsanställning", "provanställning", "praktik", "vikarie", "pensionsåldern"], "label": "Temporary Full-time"},
    {"match": "contains", "all_of": [["permanent", "tillsvidare"], ["full", "heltid"]], "label": "Permanent Full-time"},
    {"match": "contains", "all_of": [["permanent", "tillsvidare"], ["part", "deltid"]], "label": "Permanent Part-time"},
    {"match": "contains", "all_of": [["temporary", "tillfällig", "visstid"], ["full", "heltid"]], "label": "Temporary Full-time"},
    {"match": "contains", "all_of": [["temporary", "tillfällig", "visstid"], ["part", "deltid"]], "label": "Temporary Part-time"},
    {"match": "contains", "any_of": ["tillsvidareanställning", "heltidsanställning"], "label": "Permanent Full-time"},
    {"match": "equals", "any_of": ["not applicable", "ej tillämpbart", "n/a"], "label": "Not Applicable"},
    {"match": "contains", "any_of": ["self-employ", "self employ", "freelan", "egenföretagare", "konsult", "egenanställd", "aktiebolag"], "label": "Self-Employed"},
    {"match": "contains", "all_of": [["temp", "fixed", "visstid", "project", "probation", "allmän visstid", "tidkontrakt", "tidsbegräns", "timanställ", "internship", "seasonal"], ["full", "heltid", "100%"]], "label": "Temporary Full-time"},
    {"match": "contains", "all_of": [["temp", "fixed", "visstid", "project", "probation", "allmän visstid", "tidkontrakt", "tidsbegräns", "timanställ", "internship", "seasonal"], ["part", "deltid", "50%", "75%"]], "label": "Temporary Part-time"},
    {"match": "contains", "any_of": ["temp", "fixed", "visstid", "project", "probation", "allmän visstid", "tidkontrakt", "tidsbegräns", "timanställ", "internship", "seasonal"], "label": "Temporary Full-time"},
    {"match": "contains", "any_of": ["part", "deltid", "50%", "75%"], "label": "Permanent Part-time"},
    {"match": "contains", "any_of": ["permanent", "tillsvidare", "fast", "open-ended"], "label": "Permanent Full-time"},
    {"match": "contains", "any_of": ["vikarie"], "label": "Temporary Full-time"},
    {"match": "contains", "any_of": ["volontär", "arbetsträning"], "label": "Not Applicable"},
    {"match": "contains", "any_of": ["pensionsåldern"], "label": "Temporary Full-time"},
    {"match": "contains", "any_of": ["student"], "none_of": ["jobb", "job", "arbet", "assistant", "anställ", "worker", "intern"], "label": "Not Applicable"},
    {"match": "contains", "any_of": ["pension", "pensionär", "pensioner"], "label": "Not Applicable"},
    {"match": "contains", "any_of": ["full", "heltid", "100%"], "label": "Permanent Full-time"}
  ],
  "description": "Employment contract type, combining attachment (permanent/temporary/self-employed) from AM/AM0401/AM0401I/AKURLSysAnkAr and working-hours (full-time/part-time) from AM/AM0401/AM0401S/NAKUSysselOkArbtidAr. Both conditional on age_group. Non-employed get 'Not Applicable'.",
  "attachment_table": "AM/AM0401/AM0401I/AKURLSysAnkAr",
  "hours_table": "AM/AM0401/AM0401S/NAKUSysselOkArbtidAr",
  "reference_none_default": "Not Applicable",
  "reference_composite_mappings": {
    "permanent|full_time": "Permanent Full-time",
    "permanent|part_time": "Permanent Part-time",
    "temporary|full_time": "Temporary Full-time",
    "temporary|part_time": "Temporary Part-time",
    "self_employed": "Self-Employed"
  },
  "reference_attachment_mappings": {
    "permanent employees": "permanent",
    "temporary employees": "temporary",
    "self-employed + family workers": "self_employed",
    "self-employed + family workers (fa+mh)": "self_employed"
  },
  "reference_hours_mappings": {
    "1-19 hours": "part_time",
    "20-34 hours": "part_time",
    "35+ hours": "full_time"
  },
