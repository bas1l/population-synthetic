{
  "pipeline_handler": "text_coded",
  "pipeline_attr": "current_environment_type",
  "pipeline_keyword_rules": [
    {"match": "contains", "any_of": ["suburban", "suburb", "förort", "stadsnära"], "label": "Suburban"},
    {"match": "contains", "any_of": ["rural", "countryside", "village", "nomadic", "landsbygd", "glesbygd"], "label": "Rural/Countryside"},
    {"match": "equals", "any_of": ["by", "landsby"], "label": "Rural/Countryside"},
    {"match": "contains", "any_of": ["small town", "smaller town", "town", "tätort", "mindre stad"], "label": "Suburban"},
    {"match": "contains", "any_of": ["urban metropolis", "metropolis", "city center", "inner city", "major city", "storstad", "innerstad"], "label": "Urban Metropolis"},
    {"match": "contains", "any_of": ["urban", " city", "/city"], "label": "Urban Metropolis"},
    {"match": "equals", "any_of": ["city", "urban"], "label": "Urban Metropolis"}
  ],
  "pipeline_city_environment": {
    "metro": ["stockholm", "göteborg", "malmö"],
    "large": [
      "linköping", "norrköping", "uppsala", "västerås", "örebro",
      "umeå", "lund", "växjö", "sundsvall", "gävle", "borås",
      "eskilstuna", "halmstad", "jönköping", "karlstad", "kalmar",
      "helsingborg", "kristianstad", "trollhättan", "luleå",
      "nacka", "södertälje", "solna", "huddinge"
    ]
  },
  "description": "Swedish urbanization classification to schema labels",
  "scb_variable": "Tatortsgrad",
  "mappings": {
    "urban_metropolis": {
      "schema_label": "Urban Metropolis",
      "description": "Storstadskommuner (Stockholm, Gothenburg, Malmö municipalities)",
      "scb_codes": [
        "1",
        "storstad",
        "metropolitan"
      ]
    },
    "suburban": {
      "schema_label": "Suburban",
      "description": "Större städer och täta kommuner",
      "scb_codes": [
        "2",
        "3",
        "storre stad",
        "dense"
      ]
    },
    "rural": {
      "schema_label": "Rural/Countryside",
      "description": "Övriga kommuner och landsbygd",
      "scb_codes": [
        "4",
        "5",
        "6",
        "landsbygd",
        "rural",
        "sparse"
      ]
    }
  },
  "output_categories": [
    "Urban Metropolis",
    "Suburban",
    "Rural/Countryside"
  ],
  "degurba_mappings": {
    "densely populated area": "Urban Metropolis",
    "intermediate density area": "Suburban",
    "thinly populated area": "Rural/Countryside"
  }
}
