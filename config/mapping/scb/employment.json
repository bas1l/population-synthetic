{
  "reference_handler": "label",
  "reference_attr": "employment_status",
  "pipeline_handler": "text_coded",
  "pipeline_attr": "employment_status",
  "pipeline_keyword_rules": [
    {"match": "contains", "any_of": ["parental leave", "föräldraledig", "mammaledig", "pappaledig"], "label": "Employed"},
    {"match": "contains", "any_of": ["sick leave", "sjukskriven", "sjukskrivning", "disability benefit", "long-term sick", "long term sick"], "label": "Unemployed"},
    {"match": "contains", "any_of": ["military", "värnplikt", "armed forces"], "label": "Employed"},
    {"match": "contains", "any_of": ["employ", "working", "worker", "job", "anställd", "heltid", "deltid", "tillsvidare", "sysselsatt", "förvärvsarbetande", "yrkesverksam", "arbetar", "full time", "part time", "selvständig", "self-employ", "freelanc", "egenföretag", "företagare", "frilans", "eget företag", "näringsidkare", "konstnär", "projektledare", "forskare", "tjänsteman", "lönearbetande", "kok", "praktikant", "uppdragstagare"], "label": "Employed"},
    {"match": "contains", "any_of": ["unemploy", "jobless", "seeking", "arbetssökande", "arbetslos", "arbetslös", "arbetsträning", "arbetstränade", "a-kassa", "försörjning", "hemmafru", "hemvårdare"], "label": "Unemployed"},
    {"match": "contains", "any_of": ["student", "study", "school", "studying", "studerande", "studierande"], "label": "Student"},
    {"match": "contains", "any_of": ["retire", "pension"], "label": "Retired"}
  ],
  "description": "AKU (Labour Force Survey) status codes to schema labels",
  "scb_variable": "ArbetsmarknadsstStatus",
  "mappings": {
    "employed": {
      "schema_label": "Employed",
      "scb_codes": [
        "1",
        "sysselsatta",
        "employed"
      ]
    },
    "unemployed": {
      "schema_label": "Unemployed",
      "scb_codes": [
        "2",
        "3",
        "arbetslosa",
        "unemployed",
        "job-seekers"
      ]
    },
    "student": {
      "schema_label": "Student",
      "scb_codes": [
        "4",
        "studerande",
        "in education"
      ]
    },
    "retired_other": {
      "schema_label": "Retired",
      "scb_codes": [
        "5",
        "6",
        "7",
        "pensionarer",
        "retired",
        "other inactive"
      ]
    }
  },
  "reference_label_mappings": {
    "sysselsatta": "Employed",
    "employed": "Employed",
    "in employment": "Employed",
    "employed, thousands": "Employed",
    "arbetslösa": "Unemployed",
    "unemployed": "Unemployed",
    "unemployed, thousands": "Unemployed",
    "ej i arbetskraften": "Retired",
    "not in the labour force": "Retired",
    "not in the labour force, thousands": "Retired",
    "ej i arbetskraften - studerande": "Student",
    "ej i arbetskraften - pensionärer": "Retired",
    "ej i arbetskraften - övriga": "Retired",
    "not in labour force - students": "Student",
    "not in labour force - retired": "Retired",
    "not in labour force - other": "Retired"
  },
  "aku_education_label_mappings": {
    "primary and lower secondary education": "No Formal Education",
    "förgymnasial utbildning": "No Formal Education",
    "upper secondary education": "High School (Gymnasieskola)",
    "gymnasial utbildning": "High School (Gymnasieskola)",
    "post secondary education": "University Degree",
    "eftergymnasial utbildning": "University Degree"
  },
  "output_categories": [
