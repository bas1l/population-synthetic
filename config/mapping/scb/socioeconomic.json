{
  "description": "Income bracket groups to socioeconomic class labels (SamForvInk1, relative to country median)",
  "scb_variable": "Inkomstklass",
  "mappings": {
    "poverty": {
      "schema_label": "Poverty",
      "description": "Individual gross income < 60% of national median (Eurostat AROP threshold)"
    },
    "working_class": {
      "schema_label": "Working Class",
      "description": "Individual gross income 60–100% of national median (OECD lower-middle floor)"
    },
    "middle_class": {
      "schema_label": "Middle Class",
      "description": "Individual gross income 100–200% of national median (OECD middle band)"
    },
    "wealthy": {
      "schema_label": "Wealthy",
      "description": "Individual gross income >= 200% of national median (OECD/Pew upper income)"
    }
  },
  "scb_decile_mappings": {
    "Decile 1": "Poverty",
