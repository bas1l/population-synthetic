    {"match": "contains", "any_of": ["middle class", "middle-class", "medelklass", "mellanklass", "övre medelklass", "högre medelklass", "akademiker", "akademi", "god ekonomi", "pensionär", "mellanstora tjänstemän", "mellan-tjänstemän", "kvalificerad tjänsteman", "professional", "upper middle", "upper-middle", "lower middle", "lower-middle", "middle income", "middle-income", "white collar", "white-collar", "managerial", "administrative", "median income", "above median", "classe media", "ceto medio", "medio-alt", "medio alt", "media-alt", "media alt", "borghes", "classe media alt", "classe media elevat", "classe dirigent", "classe dirigenz", "mellanskikt", "medelinkomst", "giovane professionista", "giovani professionisti", "mediano", "mediocre", "högskoleutbildad", "tjänsteman", "tjänstemän", "it-", "konsult", "företagare", "egenföretagare", "professionell", "urban", "mittenklass", "mittelsocial", "middelklass", "mellanposition", "mellanliggande", "intellektuell"], "label": "Middle Class"},
    {"match": "contains", "any_of": ["wealthy", "rich", "affluent", "upper class", "välbärgad", "överklass", "högre tjänstemän", "high income", "high-income", "higher income", "higher-income", "high socioeconomic", "corporate class", "elite", "alta borghesia", "alta buona", "classe elevat", "classe emergente", "kapitalist", "hög inkomst", "höginkomst", "comfortable income", "high-earning", "high earning"], "label": "Wealthy"}
  ],
  "description": "Income bracket groups to socioeconomic class labels (SamForvInk1, relative to country median)",
  "scb_variable": "Inkomstklass",
  "mappings": {
    "poverty": {
      "schema_label": "Poverty",
      "description": "Individual gross income < 60% of national median (Eurostat AROP threshold)"
    },
    "working_class": {
      "schema_label": "Working Class",
      "description": "Individual gross income 60–100% of national median (OECD lower-middle floor)"
    },
    "middle_class": {
      "schema_label": "Middle Class",
      "description": "Individual gross income 100–200% of national median (OECD middle band)"
    },
    "wealthy": {
      "schema_label": "Wealthy",
      "description": "Individual gross income >= 200% of national median (OECD/Pew upper income)"
    }
  },
