  "pipeline_keyword_rules": [
    {"match": "contains", "any_of": ["poverty", "poor", "destitute", "fattigdom", "låginkomsttagare", "low income", "low-income", "lower income", "lower-income", "economic precariat", "precariat", "povertà", "basso reddito", "classe bassa", "marginalizzat"], "label": "Poverty"},
