{
  "reference_handler": "label",
  "reference_attr": "education_level",
  "pipeline_handler": "text_coded",
  "pipeline_attr": "education_level",
  "pipeline_keyword_rules": [
    {"match": "contains", "any_of": ["post-graduate", "postgraduate", "phd", "doctoral", "doktors", "research degree", "licentiate", "isced 6", "isced97 6"], "label": "Post-Graduate (ISCED 6)"},
    {"match": "contains", "any_of": ["post-secondary 3", "isced 5a", "isced97 5a", "university", "degree", "bachelor", "master", "kandidat", "magister", "högskolex", "högskole", "hogskola", "akademisk", "universitet", "tertiary", "undergraduate", "baccalaure", "first cycle", "higher education"], "label": "Post-Secondary 3+ yrs (ISCED 5A)"},
    {"match": "contains", "any_of": ["post-secondary <", "isced 4", "isced 5b", "isced97 4", "isced97 5b", "vocational", "yrkeshogskola", "yrkeshögskola", "yrkes", "higher vocational", "yh-"], "label": "Post-Secondary < 3 yrs (ISCED 4+5B)"},
    {"match": "contains", "any_of": ["lower secondary"], "label": "Pre-Secondary 9-10 yrs (ISCED 2)"},
    {"match": "contains", "any_of": ["upper secondary 3", "upper-secondary", "isced 3a", "isced97 3a", "gymnasium", "high school", "gymnasieskola", "gymnasie", "gymnasial", "secondary education", "secondary school", "higher secondary"], "label": "Upper Secondary 3 yrs (ISCED 3A)"},
    {"match": "contains", "any_of": ["upper secondary", "isced 3c", "isced97 3c"], "label": "Upper Secondary ≤ 2 yrs (ISCED 3C)"},
    {"match": "contains", "any_of": ["pre-secondary 9", "isced 2", "isced97 2", "grundskola", "compulsory", "elementary", "primary school", "folkskola", "realskoleexamen"], "label": "Pre-Secondary 9-10 yrs (ISCED 2)"},
    {"match": "contains", "any_of": ["pre-secondary <", "isced 1", "isced97 1", "no formal", "primary", "ingen utbildning", "ingen formell", "lägre grundskola"], "label": "Pre-Secondary < 9 yrs (ISCED 1)"},
    {"match": "contains", "any_of": ["unknown", "not reported", "uppgift saknas"], "label": "Unknown / Not reported"}
  ],
  "description": "SUN2020 education level codes to schema labels",
  "scb_variable": "Sun2000Niva",
  "mappings": {
