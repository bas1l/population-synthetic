{
  "reference_handler": "label",
  "pipeline_handler": "text_coded",
  "pipeline_fuzzy": false,
  "output_categories": ["Female", "Male"],
  "pipeline_keyword_rules": [
    {"match": "contains", "any_of": ["female", "kvinna", "kvinnlig", "kvinnor", "flicka", "tjej", "hona", "woman"], "label": "Female"},
    {"match": "equals", "any_of": ["xx", "hon", "f"], "label": "Female"},
    {"match": "contains", "any_of": ["male", "pojke", "kille", "manlig"], "label": "Male"},
    {"match": "equals", "any_of": ["man", "xy", "m", "män"], "label": "Male"},
    {"match": "contains", "any_of": ["kön man"], "label": "Male"}
  ],
  "description": "Biological sex raw labels/codes to canonical schema labels",
  "reference_label_mappings": {
    "men": "Male",
    "male": "Male",
    "1": "Male",
    "women": "Female",
    "female": "Female",
    "2": "Female"
  }
}
