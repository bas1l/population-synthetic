{
  "_comment": "Norwegian SSB PxWebApi v2 code-to-schema label mappings. Raw SSB response codes/labels are translated to the schema-normalised labels used in PopulationDistributions.",

  "age_groups": {
    "description": "Age group labels used in the output — standardised 7-bin scheme shared with SCB module",
    "groups": [
      {"label": "18-24", "min": 18, "max": 24},
      {"label": "25-34", "min": 25, "max": 34},
      {"label": "35-44", "min": 35, "max": 44},
      {"label": "45-54", "min": 45, "max": 54},
      {"label": "55-64", "min": 55, "max": 64},
      {"label": "65-74", "min": 65, "max": 74},
      {"label": "75-85", "min": 75, "max": 85}
    ],
    "ssb_table_07459_to_group": {
      "comment": "Table 07459 uses single-year Alder codes (3-digit, zero-padded). Ages mapped to our bins; ages outside 18-85 are dropped.",
      "018": "18-24", "019": "18-24", "020": "18-24", "021": "18-24", "022": "18-24", "023": "18-24", "024": "18-24",
      "025": "25-34", "026": "25-34", "027": "25-34", "028": "25-34", "029": "25-34",
      "030": "25-34", "031": "25-34", "032": "25-34", "033": "25-34", "034": "25-34",
      "035": "35-44", "036": "35-44", "037": "35-44", "038": "35-44", "039": "35-44",
      "040": "35-44", "041": "35-44", "042": "35-44", "043": "35-44", "044": "35-44",
      "045": "45-54", "046": "45-54", "047": "45-54", "048": "45-54", "049": "45-54",
      "050": "45-54", "051": "45-54", "052": "45-54", "053": "45-54", "054": "45-54",
      "055": "55-64", "056": "55-64", "057": "55-64", "058": "55-64", "059": "55-64",
      "060": "55-64", "061": "55-64", "062": "55-64", "063": "55-64", "064": "55-64",
      "065": "65-74", "066": "65-74", "067": "65-74", "068": "65-74", "069": "65-74",
      "070": "65-74", "071": "65-74", "072": "65-74", "073": "65-74", "074": "65-74",
      "075": "75-85", "076": "75-85", "077": "75-85", "078": "75-85", "079": "75-85",
      "080": "75-85", "081": "75-85", "082": "75-85", "083": "75-85", "084": "75-85", "085": "75-85"
    },
    "ssb_table_08921_to_group": {
      "comment": "Table 08921 (education by age/sex) uses band codes. Bands that partly overlap our range are mapped to the nearest bin.",
      "16-19": "18-24",
      "20-24": "18-24",
      "25-29": "25-34",
      "30-39": "25-34",
      "40-49": "35-44",
      "50-59": "45-54",
      "60-66": "55-64",
      "067+": "65-74"
    },
    "ssb_table_03031_to_group": {
      "comment": "Table 03031 (civil status by age/sex) uses decade bands.",
      "0": "18-24",
      "1": "18-24",
      "2": "18-24",
      "3": "25-34",
      "4": "35-44",
      "5": "45-54",
      "6": "55-64",
      "7": "65-74",
      "8": "75-85",
      "9": "75-85"
    }
  },

  "education": {
    "description": "Norwegian education level codes (NUS2000-style SSB classification) to schema labels. Used in tables 08921, 09429, 09599.",
    "ssb_variable": "UtdanNivaa",
    "ssb_tables": ["08921", "09429", "09599"],
    "mappings": {
      "no_formal": {
        "schema_label": "No Formal Education",
        "ssb_codes": ["00", "01", "09a", "0_9", "1-2", "Uoppgitt eller ingen fullført utdanning", "Grunnskolenivå"]
      },
      "high_school": {
        "schema_label": "High School (Videregående)",
        "ssb_codes": ["02a", "3-5", "3-5a", "Videregående skolenivå"]
      },
      "vocational": {
        "schema_label": "Vocational (Fagskole)",
        "ssb_codes": ["11", "Fagskolenivå"]
      },
      "university": {
        "schema_label": "University Degree",
        "ssb_codes": ["03a", "04a", "6", "7-8", "6-8", "Universitets- og høgskolenivå, kort", "Universitets- og høgskolenivå, lang", "Universitets- og høgskolenivå"]
      }
    },
    "label_mappings": {
      "grunnskoleniå": "No Formal Education",
      "grunnskolenivå": "No Formal Education",
      "uoppgitt eller ingen fullført utdanning": "No Formal Education",
      "ingen fullført utdanning": "No Formal Education",
      "videregående skolenivå": "High School (Videregående)",
      "fagskolenivå": "Vocational (Fagskole)",
      "universitets- og høgskolenivå, kort": "University Degree",
      "universitets- og høgskolenivå, lang": "University Degree",
      "universitets- og høgskolenivå": "University Degree"
    }
  },

  "employment": {
    "description": "Labour force status from table 13618 (ArbStyrkStatus). Combined with education level for employment_by_sex_education conditional distribution.",
    "ssb_variable": "ArbStyrkStatus",
    "ssb_tables": ["13618", "13785"],
    "mappings": {
      "employed": {
        "schema_label": "Employed",
        "ssb_codes": ["1", "Sysselsatte"]
      },
      "unemployed": {
        "schema_label": "Unemployed",
        "ssb_codes": ["2", "Arbeidsledige"]
      },
      "student": {
        "schema_label": "Student",
        "ssb_codes": ["student", "under utdanning"]
      },
      "retired_other": {
        "schema_label": "Retired",
        "ssb_codes": ["6", "Personer utenfor arbeidsstyrken"]
      }
    },
    "label_mappings": {
      "sysselsatte": "Employed",
      "arbeidsledige": "Unemployed",
      "personer utenfor arbeidsstyrken": "Retired",
      "employed": "Employed",
      "unemployed": "Unemployed",
      "not in the labour force": "Retired",
      "outside the labour force": "Retired"
    },
    "education_label_mappings": {
      "grunnskolenivå": "No Formal Education",
      "uoppgitt eller ingen fullført utdanning": "No Formal Education",
      "videregående skolenivå": "High School (Videregående)",
      "fagskolenivå": "Vocational (Fagskole)",
      "universitets- og høgskolenivå": "University Degree",
      "1-2": "No Formal Education",
      "3-5": "High School (Videregående)",
      "11": "Vocational (Fagskole)",
      "6-8": "University Degree",
      "0_9": "No Formal Education"
    }
  },

