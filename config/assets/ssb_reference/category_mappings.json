  "socioeconomic": {
    "description": "Socioeconomic class derived from individual gross income brackets (table 06655, BruttoInn × Alder × Kjonn). Country median computed from bracket midpoints × counts; Eurostat AROP (0.60×) and OECD/Pew (1.00×, 2.00×) multipliers applied. Conditional on (age_group, sex).",
    "ssb_variable": "BruttoInn",
    "ssb_table": "06655",
    "mappings": {
      "poverty": {
        "schema_label": "Poverty",
        "description": "Gross individual income < 0.60 × national median (Eurostat AROP threshold)"
      },
      "working_class": {
        "schema_label": "Working Class",
        "description": "Gross individual income 0.60 – 1.00 × national median (OECD lower-middle floor)"
      },
      "middle_class": {
        "schema_label": "Middle Class",
        "description": "Gross individual income 1.00 – 2.00 × national median (OECD middle band)"
      },
      "wealthy": {
        "schema_label": "Wealthy",
        "description": "Gross individual income >= 2.00 × national median (OECD/Pew upper income)"
      }
    }
  },

  "income_source": {
    "description": "Primary income source. SSB does not provide a direct income-source-by-employment-status table equivalent to SCB's HE0110F in PxWebApi v2. Approximate distributions are derived from AKU-based employment status (table 13618) and Norwegian NAV statistics on transfer payments. This is a simplified fallback with 3 broad categories.",
    "fallback_note": "No SSB PxWebApi v2 table provides income component shares conditioned jointly on employment status and age group at national level. Fetch service uses approximate distributions.",
    "approximate_distributions": {
      "Employed": {
        "Employment income": 0.85,
        "Capital income": 0.05,
        "Social transfers": 0.05,
        "Pension": 0.03,
        "Business/self-employment": 0.02
      },
      "Unemployed": {
        "Social transfers": 0.75,
        "Employment income": 0.15,
        "Capital income": 0.05,
        "Pension": 0.03,
        "Business/self-employment": 0.02
      },
      "Student": {
        "Social transfers": 0.70,
        "Employment income": 0.20,
        "Capital income": 0.05,
        "Pension": 0.03,
        "Business/self-employment": 0.02
      },
      "Retired": {
        "Pension": 0.80,
        "Capital income": 0.10,
        "Social transfers": 0.07,
        "Employment income": 0.02,
        "Business/self-employment": 0.01
      }
    },
    "output_categories": [
      "Employment income",
      "Business/self-employment",
      "Pension",
      "Social transfers",
      "Capital income"
    ]
  },

