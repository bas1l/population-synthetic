    "ssb_table": "04859",
    "mappings": {
      "urban_metropolis": {
        "schema_label": "Urban Metropolis",
        "description": "Oslo and larger cities — >85% of fylke population in urban settlements"
      },
      "suburban": {
        "schema_label": "Suburban",
        "description": "Mid-sized towns and densely settled areas — 60–85% urban"
      },
      "rural": {
        "schema_label": "Rural/Countryside",
